<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Library Security Category -->
    <record id="module_category_all_library" model="ir.module.category">
        <field name="name">Library</field>
        <field name="description">
            Helps you manage your institute library users.
        </field>
        <field name="sequence">107</field>
        <field name="parent_id" eval="False"/>
    </record>

    <!-- Library Group Privilege -->
    <record id="module_privilege_openeducat_library"
            model="res.groups.privilege">
        <field name="name">Library</field>
        <field name="description">
            Helps you manage your institute library users.
        </field>
        <field name="category_id" ref="module_category_all_library"/>
        <field name="sequence">18</field>
    </record>

    <!-- Library User -->
    <record id="group_op_library_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id"
               ref="module_privilege_openeducat_library"/>
        <field name="implied_ids"
               eval="[(4, ref('base.group_user'))]"/>
        <field name="user_ids"
               eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <!-- Library Manager -->
    <record id="group_op_library" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id"
               ref="module_privilege_openeducat_library"/>
        <field name="implied_ids"
               eval="[
                   (4, ref('base.group_user')),
                   (4, ref('account.group_account_invoice')),
                   (4, ref('openeducat_library.group_op_library_user'))
               ]"/>
        <field name="user_ids"
               eval="[(4, ref('base.user_admin'))]"/>
    </record>

</odoo>
