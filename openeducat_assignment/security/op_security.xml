<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="privilege_module_category_all_op_assignment">
        <field name="name">Assignment</field>
        <field name="description">Helps you manage your institutes different-different users.</field>
        <field name="sequence">105</field>
    </record>

    <record model="res.groups.privilege" id="privilege_module_category_openeducat_assignment">
        <field name="name">Assignment</field>
        <field name="description">Helps you manage your institutes different-different users.</field>
        <field name="category_id" ref="privilege_module_category_all_op_assignment"/>
        <field name="sequence">16</field>
    </record>

    <record id="group_op_assignment_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_module_category_openeducat_assignment"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        <field name="implied_ids"
               eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_op_assignment_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_module_category_openeducat_assignment"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        <field name="implied_ids"
               eval="[(4, ref('openeducat_assignment.group_op_assignment_user'))]"/>
    </record>


